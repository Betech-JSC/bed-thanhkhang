APP_NAME='HH Maker'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jam-boilerplate-monolith-v3
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=10080

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_APP_PORT=13714

IGNITION_EDITOR=vscode

# Google OAuth (for login/register with Google). Get credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: default is APP_URL + /auth/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=storage/app/google/credentials.json

# SePay Payment Integration
# Đăng ký tại: https://sepay.vn
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
SEPAY_QR_EXPIRES_MINUTES=15
SEPAY_QR_TEMPLATE=compact

# PayPal Payment Integration (Thanh toán quốc tế)
# Đăng ký tại: https://developer.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=25000

# Synology NAS Integration
SYNOLOGY_HOST=https://funkystyle.synology.me:5101
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
