<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Unit,Feature"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <file>./tests/Feature/ExampleTest.php</file>
            <file>./tests/Feature/CmsSyncIntegrationTest.php</file>
            <file>./tests/Feature/AboutPageCmsTest.php</file>
            <file>./tests/Feature/DangNhapRedirectTest.php</file>
            <file>./tests/Feature/PolicyTest.php</file>
            <file>./tests/Feature/BackendProductTest.php</file>
        </testsuite>
        <testsuite name="Legacy">
            <file>./tests/Feature/ProductTest.php</file>
            <file>./tests/Feature/SeoPhase1FixesTest.php</file>
            <file>./tests/Feature/SeoPhase2Test.php</file>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/A75G2RTiWVA/ZoKZvp6fiiM10=" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
